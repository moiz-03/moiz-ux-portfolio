
# ---- Resend (required for email) ----
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Where enquiries should land (your inbox)
CONTACT_TO_EMAIL=your-email@example.com

# Verified sender. Use "onboarding@resend.dev" until you verify your domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---- Upstash Redis (optional — rate limiting) ----
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ---- Telegram (optional — instant mobile alert) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
